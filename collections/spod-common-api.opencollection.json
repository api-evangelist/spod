{
  "opencollection": "1.0.0",
  "info": {
    "name": "SPOD (Spreadconnect) Fulfillment REST Articles Common API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-SPOD-ACCESS-TOKEN",
      "value": "{{X-SPOD-ACCESS-TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Common",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verify the API access token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.spod.com/authentication"
          },
          "docs": "Returns authentication information for the supplied access token, used to confirm credentials are valid."
        }
      ]
    }
  ],
  "bundled": true
}