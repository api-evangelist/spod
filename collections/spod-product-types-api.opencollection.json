{
  "opencollection": "1.0.0",
  "info": {
    "name": "SPOD (Spreadconnect) Fulfillment REST Articles Product Types API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-SPOD-ACCESS-TOKEN",
      "value": "{{X-SPOD-ACCESS-TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Product Types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List product types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.spod.com/productTypes"
          },
          "docs": "List the catalog of available product types (article types) that articles can be built from."
        },
        {
          "info": {
            "name": "Get a product type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.spod.com/productTypes/:productTypeId",
            "params": [
              {
                "name": "productTypeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a product type with its sizes, colors, views, and printable areas."
        }
      ]
    }
  ],
  "bundled": true
}