{
  "opencollection": "1.0.0",
  "info": {
    "name": "SPOD (Spreadconnect) Fulfillment REST Articles Shipping API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-SPOD-ACCESS-TOKEN",
      "value": "{{X-SPOD-ACCESS-TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Shipping",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get available shipping types for an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.spod.com/orders/:orderId/shippingTypes",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List the shipping types available for the order, including price and estimated delivery time."
        },
        {
          "info": {
            "name": "Set the shipping type for an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://rest.spod.com/orders/:orderId/shippingType",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Set the shipping type for an order"
        },
        {
          "info": {
            "name": "Get shipments for an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.spod.com/orders/:orderId/shipments",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the shipment records for an order, including carrier and tracking details once dispatched."
        }
      ]
    }
  ],
  "bundled": true
}